{
  "expo": {
    "name": "Scanified",
    "slug": "scanified",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "scanified",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1214"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scanified.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanified uses the camera to scan asset barcodes when you ship and receive them.",
        "NSLocationWhenInUseUsageDescription": "Scanified records where a scan happened so a delivery can be proven later.",
        "NSFaceIDUsageDescription": "Unlock Scanified with Face ID instead of typing your password.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.scanified.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1214"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "Scanified uses the camera to scan asset barcodes." }],
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Scanified records where a scan happened." }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "router": {},
      "eas": { "projectId": "REPLACE_AFTER_EAS_INIT" }
    }
  }
}
