{
  "expo": {
    "name": "Scanified",
    "slug": "scanified",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fad89b31-ae33-4bff-9011-af88c8268844",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "scheme": "scanified",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#07090A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.evanevoo.scanifiedmobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanified uses the camera to scan asset barcodes when you ship and receive them.",
        "NSLocationWhenInUseUsageDescription": "Scanified records where a scan happened so a delivery can be proven later.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.scanified.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07090A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scanified uses the camera to scan asset barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Scanified records where a scan happened so a delivery can be proven later."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "scanified",
          "project": "scanified-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fad89b31-ae33-4bff-9011-af88c8268844"
      }
    },
    "owner": "evanevoo"
  }
}
