# Copy to .env. Everything here is EXPO_PUBLIC_*, which means it is compiled
# into the app bundle and shipped to every handset — treat all of it as public
# and never put a secret key in this file. The service-role key and the SMTP
# credentials belong to the web app, on the server, and must never appear here.

# Where the handset talks to.
#
# Local development needs an address the PHONE can reach, and "localhost" means
# the phone itself. Either your machine's LAN address (same wifi only) or a
# tunnel. A dead tunnel returns 503 and looks exactly like a broken app —
# bootstrap fails, the customer list never lands, and every customer barcode
# scans as unrecognised text.
#
# Production values live in eas.json per build profile, NOT here, and EAS bakes
# them into the uploaded archive when the build is TRIGGERED. Change them before
# you kick a build or the build ships the old value.
EXPO_PUBLIC_API_URL="https://your-deployment.example.com"

EXPO_PUBLIC_SUPABASE_URL="https://YOURPROJECT.supabase.co"

# The publishable key (sb_publishable_…), not the legacy JWT anon key — those
# were disabled when the JWT signing key was rotated.
EXPO_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
